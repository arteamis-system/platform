# The entire pipeline for this repository.
# Logic lives in devsecops-playground-org/platform; this file only points at it.
name: CI/CD

on:
  push:
    branches: [main, deploy/staging, deploy/prod]
  pull_request:
  workflow_dispatch:

jobs:
  pipeline:
    uses: devsecops-playground-org/platform/.github/workflows/_dispatch.yml@v1
    permissions:
      contents: read
      packages: write
      id-token: write
      security-events: write
      issues: write
    # The dispatcher is this org's own pinned @v1 workflow, not a third party;
    # inheriting secrets to it is the intended design.
    secrets: inherit # nosemgrep: yaml.github-actions.security.secrets-inherit.secrets-inherit
