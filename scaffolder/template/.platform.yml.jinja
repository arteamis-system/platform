# What this repository IS. The platform decides what to DO with it.
# Schema: https://github.com/devsecops-playground-org/platform#the-manifest
project: {{ project }}
component: {{ component }}
type: {{ type }}
runtime: {{ runtime }}
package_manager: {{ package_manager }}

test:
  command: {{ test_command }}
  coverage_min: {{ coverage_min }}
  ai_review: {{ ai_review | lower }}
{%- if tester_agent %}
  # The autonomous tester. Read-only against staging, hard-bounded by
  # iterations, wall-clock and spend — whichever ceiling is hit first ends a run.
  tester_agent:
    enabled: true
    scope:
      base_url_secret: TESTER_BASE_URL
      mutating: false
    slo:
      latency_p95_ms: {{ slo_p95_ms }}
    soak:
      enabled: true
      iterations: 20
      budget_minutes: 10
      token_budget_usd: 3
      gate_on: [functional_high, latency_p95_slo]
    monitor:
      enabled: true
      schedule: "{{ monitor_schedule }}"
      target: {{ monitor_target }}

report:
  issues:
    repo: self
    auto_close_after_runs: 3
  lark:
    notify_on: [gate_block, new_high, auto_resolved]
  baselines:
    metric: p95
    drift_pct: 30
    sustained_runs: 2
{%- endif %}
{% if type == 'service' %}
build:
  dockerfile: Dockerfile
  context: .
{% endif %}
deploy:
  target: {{ target }}
{%- if target == 'vm' %}
  service: {{ component }}
  container_name: {{ project }}-{{ component }}
  compose_file: docker-compose.prod.yml
  health:
    path: /health
    port: {{ http_port }}
{%- endif %}
{%- if target != 'none' %}
  environments:
    staging:
      branch: deploy/staging
      url: https://{{ component }}.staging.{{ domain }}
    production:
      branch: deploy/prod
      url: https://{{ component }}.{{ domain }}
{%- endif %}
