# {{ project }}: {% if needs_vm %}one {{ vm_cloud | upper }} VM per environment running {{ vm_components | join(", ") }}{% else %}frontend-only — Vercel + DNS, no VM{% endif %}.
# A dozen lines calling the shared `project` module; the module holds the logic,
# this directory holds the declaration. Generated by scaffolder-infra — edit the
# values, not the plumbing.

module "{{ project }}" {
  source = "git::https://github.com/devsecops-playground-org/platform.git//modules/project?ref=v1"

  project      = "{{ project }}"
  environments = {{ environments | tojson }}

  domain      = "{{ domain }}"
  dns_zone_id = var.dns_zone_id

  needs_vm       = {{ needs_vm | lower }}
{%- if needs_vm %}
  vm_cloud       = "{{ vm_cloud }}"
  vm_components  = {{ vm_components | tojson }}
{%- endif %}
  vercel_domains = {{ vercel_domains | tojson }}
{% if needs_vm %}
{%- if vm_cloud == 'gcp' %}
  gcp_project_id = var.gcp_project_id
  gcp_region     = "{{ gcp_region }}"
  gcp_zone       = "{{ gcp_zone }}"
{% endif %}
  vm = {
    size         = "{{ vm_size }}"
    staging_size = "{{ vm_staging_size }}"
  }

  deploy_public_key = var.deploy_public_key
  ssh_allowed_cidrs = {{ ssh_allowed_cidrs | tojson }}
{%- endif %}
}
